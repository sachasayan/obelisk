{
  "name": "obelisk",
  "version": "0.1.0",
  "description": "Obelisk",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^24.22.3 || ^26.0.0",
    "npm": "^11.0.0"
  },
  "allowScripts": {
    "rpi-led-matrix": true
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "obelisk": "npm run obelisk --workspace obelisk-server",
    "clientbuild": "npm run build --workspace obelisk-client",
    "clientstart": "npm run start --workspace obelisk-client",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "check": "npm run typecheck && npm run clientbuild && npm test",
    "simulate": "npm run clientbuild && npm run simulate --workspace obelisk-server"
  }
}
